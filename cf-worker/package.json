{
  "name": "infection-echo-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker proxy that holds the OpenAI / ElevenLabs API keys server-side for the Infection Echo project.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "secret:openai": "wrangler secret put OPENAI_API_KEY",
    "secret:eleven": "wrangler secret put ELEVENLABS_API_KEY"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "jose": "^5.9.6"
  }
}
